# ─────────────────────────────────────────────────────────────
# Client environment — copy to `.env` (never commit `.env`)
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put a Supabase service-role key or the Anthropic key here.
# ─────────────────────────────────────────────────────────────

# App name shown in the UI
VITE_APP_NAME="CampusFix"

# Base URL for the Express API (AI triage + health only). Keep "/api" in
# development — Vite proxies it to the server below.
VITE_API_URL=/api
VITE_PROXY_TARGET=http://localhost:4000

# REQUIRED: Supabase project (Dashboard → Project Settings → API).
# The anon/publishable key only — data access, auth, storage and realtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
