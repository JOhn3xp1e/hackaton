# ─────────────────────────────────────────────────────────────
# Client environment — copy to `.env` (never commit `.env`)
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put a Supabase service-role key or DB password here.
# ─────────────────────────────────────────────────────────────

# App name shown in the UI
VITE_APP_NAME="Hackathon Starter"

# Base URL for the REST API. Keep "/api" in development (Vite proxies it to
# the Express server). In production set the full URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Where the dev proxy forwards /api requests
VITE_PROXY_TARGET=http://localhost:4000

# true  = use local mock data (frontend works with no backend running)
# false = call the real Express API
VITE_USE_MOCKS=true

# Optional: direct Supabase access from the browser (anon/publishable key ONLY,
# protected by Row Level Security). Leave empty to go through the Express API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
