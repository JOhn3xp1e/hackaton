# ─────────────────────────────────────────────────────────────
# Server environment — copy to `.env` (never commit `.env`)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Supabase ────────────────────────────────────────────────
# Leave empty to run with the in-memory store (great for first hours of the hackathon).
# Find these in Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
# Server-only secret. Bypasses Row Level Security. NEVER expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: use the anon key instead if you want RLS enforced on server queries too.
SUPABASE_ANON_KEY=
