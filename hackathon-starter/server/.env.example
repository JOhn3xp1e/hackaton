# ─────────────────────────────────────────────────────────────
# Server environment — copy to `.env` (never commit `.env`)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Supabase ────────────────────────────────────────────────
# Required: used to verify user sessions and by the demo seed script.
# Find these in Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
# Server-only secret. Bypasses Row Level Security. NEVER expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: use the anon key instead if you want RLS enforced on server queries too.
SUPABASE_ANON_KEY=

# ── Claude AI triage ───────────────────────────────────────
# Powers POST /api/triage (suggests category + severity + summary).
# Leave empty to disable; the report form still works without it.
ANTHROPIC_API_KEY=

# Default super admin created by npm run seed:demo (min 6 chars)
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=admin123
